---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";

import { itemActions } from "./variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof itemActions>;

const { tone, class: className, ...rest } = Astro.props;
---

<div {...rest} class={itemActions({ tone, class: className })} data-slot="item-actions">
  <slot />
</div>
