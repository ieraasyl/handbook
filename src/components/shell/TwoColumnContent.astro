---
const { toc } = Astro.locals.starlightRoute;
---

<div
  class:list={[
    "min-w-0",
    toc &&
      "min-[72rem]:grid min-[72rem]:grid-cols-[minmax(0,1fr)_13.5rem] min-[72rem]:in-data-outline-hidden:grid-cols-1 print:block",
  ]}
>
  {toc && (
    <aside
      id="page-outline"
      class="sticky top-(--sl-nav-height) z-20 min-w-0 self-start min-[72rem]:col-start-2 min-[72rem]:row-start-1 min-[72rem]:in-data-outline-hidden:hidden print:hidden"
    >
      <slot name="right-sidebar" />
    </aside>
  )}
  <div class="min-w-0 min-[72rem]:col-start-1 min-[72rem]:row-start-1">
    <slot />
  </div>
</div>
