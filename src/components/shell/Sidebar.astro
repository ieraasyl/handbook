---
import { Icon } from "@astrojs/starlight/components";
import config from "virtual:starlight/user-config";
import { Button } from "../starwind/button";
import { Sidebar, SidebarContent } from "../starwind/sidebar";
import SidebarTree from "./SidebarTree.astro";
import ThemeToggle from "./ThemeToggle.astro";

const label = Astro.locals.t("sidebarNav.accessibleLabel");
---

<Sidebar mobileTitle={label}>
  <SidebarContent class="overscroll-contain">
    <nav aria-label={label}>
      <SidebarTree />
    </nav>
  </SidebarContent>
  <div class="flex shrink-0 items-center gap-2 border-t border-border p-4 min-[50rem]:hidden">
    {(config.social ?? []).map(({ href, icon, label }) => (
      <Button href={href} rel="me" aria-label={label} variant="social" size="icon">
        <Icon name={icon} size="1.1rem" />
      </Button>
    ))}
    <div class="ms-auto">
      <ThemeToggle />
    </div>
  </div>
</Sidebar>
